// Assets-only deploy: Cloudflare serves the static export in `out/`.
// There is no Worker script, so there's no CPU or bundle-size budget to manage.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kittora",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
