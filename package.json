{
  "name": "kittora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DB_TARGET=STAGING drizzle-kit migrate",
    "preview": "next build && wrangler dev --port 8788",
    "deploy": "next build && wrangler deploy",
    "db:migrate:live": "DB_TARGET=LIVE drizzle-kit migrate",
    "seed": "tsx scripts/seed.ts",
    "rls:check": "tsx scripts/rls-check.ts",
    "import:crawl": "tsx scripts/import/crawl.ts",
    "import:compress": "tsx scripts/import/compress-images.ts",
    "import:theme": "tsx scripts/import/theme.ts",
    "import:baseline": "tsx scripts/import/baseline.ts",
    "import:tokens": "tsx scripts/import/tokens.ts",
    "import:report": "tsx scripts/import/report.ts",
    "tokens": "tsx scripts/build-tokens.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.10",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chrome-launcher": "^1.2.2",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "lighthouse": "^13.5.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=24"
  }
}
