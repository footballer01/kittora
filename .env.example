# Copy to .env.local and fill in. Never commit .env.local.
# See README "Environment" for where production values live.

# --- Public: inlined into the static site at build time ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Safe in the browser: RLS guards every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Web Analytics beacon token (optional; analytics off when empty)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Private: scripts only (migrations, seed). Never read by the site. ---
# Session pooler, port 5432
DATABASE_URL_DIRECT=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin accounts (read only by the seed script) ---
ADMIN_1_USERNAME=
ADMIN_1_PASSWORD=
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD=
ADMIN_3_USERNAME=
ADMIN_3_PASSWORD=

# Edge Function secrets live in Supabase (supabase secrets set ...), not here:
# GMAIL_USER, GMAIL_APP_PASSWORD, GITHUB_DEPLOY_TOKEN, GITHUB_REPO
