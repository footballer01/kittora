# Copy to .env.local and fill in. Never commit .env.local.
# See README "Environment" for where production values live.

# --- Public: inlined into the static site at build time ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local dev uses the STAGING project (same values as STAGING_SUPABASE_URL/ANON_KEY).
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Safe in the browser: RLS guards every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Web Analytics beacon token (optional; analytics off when empty)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Private: scripts only (migrations, seed, RLS checks). Never read by the site. ---
# Supabase dashboard → Project Settings → API (URL, anon key, service_role key)
# and → Database → Connection string → "Session pooler" (port 5432).
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_DATABASE_URL_DIRECT=

LIVE_SUPABASE_URL=
LIVE_SUPABASE_ANON_KEY=
LIVE_SUPABASE_SERVICE_ROLE_KEY=
LIVE_DATABASE_URL_DIRECT=

# --- Admin accounts (read only by the seed script; passwords ≥ 12 characters) ---
ADMIN_1_USERNAME=
ADMIN_1_PASSWORD=
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD=
ADMIN_3_USERNAME=
ADMIN_3_PASSWORD=

# Edge Function secrets live in Supabase (supabase secrets set ...), not here:
# GMAIL_USER, GMAIL_APP_PASSWORD, GITHUB_DEPLOY_TOKEN, GITHUB_REPO
