# Copy to .env.local and fill in. Never commit .env.local.
# Production values for the Worker go in Cloudflare (wrangler secret put) and
# GitHub repo secrets/variables — see README "Environment".

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Web Analytics beacon token (optional; analytics off when empty)
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# --- Supabase (use the STAGING project locally; live only in production) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler, port 6543 (used by the app at runtime)
DATABASE_URL=
# Session pooler, port 5432 (used by drizzle-kit migrations and seed)
DATABASE_URL_DIRECT=

# --- Razorpay (test keys locally) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Admin accounts (read only by the seed script) ---
ADMIN_1_USERNAME=
ADMIN_1_PASSWORD=
ADMIN_2_USERNAME=
ADMIN_2_PASSWORD=
ADMIN_3_USERNAME=
ADMIN_3_PASSWORD=

# Order email uses GMAIL_USER and GMAIL_APP_PASSWORD, stored as Supabase
# Edge Function secrets (supabase secrets set ...), not here.
